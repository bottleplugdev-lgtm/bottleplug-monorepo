# Local Development Environment Configuration
# Copy this file to .env.local and update with your actual values

# Local Backend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=Bottleplug Dashboard (Local)
VITE_APP_ENVIRONMENT=development
VITE_DEBUG_MODE=true
VITE_ENABLE_LOGGING=true

# Firebase Configuration (Your Development Project)
VITE_FIREBASE_API_KEY=your-actual-dev-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-actual-dev-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-actual-dev-project-id

# Flutterwave Configuration (Your Test Keys)
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your-actual-test-key
VITE_FLUTTERWAVE_ENVIRONMENT=sandbox

# Local Network Configuration (for testing on physical devices)
# Update this IP to match your computer's IP address
VITE_LOCAL_NETWORK_IP=192.168.1.100
